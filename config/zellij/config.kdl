//
// THIS FILE WAS AUTOGENERATED BY ZELLIJ, THE PREVIOUS FILE AT THIS LOCATION WAS COPIED TO: /Users/fm/.config/zellij/config.kdl.bak.1
//

keybinds preset="unlock-first" unlock="Ctrl g" {
    // Cmd+1-9 and Cmd+Left/Right (sent by Ghostty as Alt F1-F9 and Ctrl Alt Left/Right) always drive
    // this outer zellij, also when it is locked to pass other keys to a nested zellij
    shared {
        bind "Alt F1" { GoToTab 1; }
        bind "Alt F2" { GoToTab 2; }
        bind "Alt F3" { GoToTab 3; }
        bind "Alt F4" { GoToTab 4; }
        bind "Alt F5" { GoToTab 5; }
        bind "Alt F6" { GoToTab 6; }
        bind "Alt F7" { GoToTab 7; }
        bind "Alt F8" { GoToTab 8; }
        bind "Alt F9" { GoToTab 9; }
        bind "Ctrl Alt left" { GoToPreviousTab; }
        bind "Ctrl Alt right" { GoToNextTab; }
        // Ctrl+? (sent by Ghostty as Ctrl+F12) shows/hides the status bar in the default layout
        bind "Ctrl F12" { ToggleBars "status-bar"; }
    }
    // The preset binds its Alt (Option) shortcuts in locked mode too; free them there so locked
    // passes them on to the shell or a nested zellij. They still work after unlocking (Ctrl g).
    locked {
        unbind "Alt left" "Alt right" "Alt n" "Alt f" "Alt i" "Alt o" "Alt h" "Alt l" "Alt j" "Alt k" "Alt down" "Alt up" "Alt =" "Alt +" "Alt -" "Alt [" "Alt ]" "Alt p" "Alt Shift p"
    }
    // Scrolling with the mouse wheel enters Scroll mode (scroll_mode_sync); Enter/Esc jump back to
    // the bottom before locking, otherwise the still-scrolled pane switches straight back to Scroll
    scroll {
        bind "Enter" "Esc" { ScrollToBottom; SwitchToMode "Locked"; }
        // not used; also keeps the "Scroll page" hint short (PageUp/PageDown, Left/Right, h/l remain)
        unbind "Ctrl b" "Ctrl f"
        // e: edit the scrollback in nvim (plain text); v: view it in less with colors
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
        bind "v" { EditScrollback { ansi true; }; SwitchToMode "Locked"; }
    }
    // y: copy the visible screen of the current pane to the clipboard as rich text (macOS)
    session {
        bind "y" { Run "/Users/fm/.config/zellij/bin/yank-rich" { background true; }; SwitchToMode "Locked"; }
        bind "Y" { Run "/Users/fm/.config/zellij/bin/yank-rich" "--full" { background true; }; SwitchToMode "Locked"; }
    }
}

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    // patched bars plugin (local build): `prefix` replaces " Zellij " in compact mode too
    compact-bar location="zellij:bars" {
        role "compact-bar"
        prefix " {hostname} "
        // Ctrl+? (sent by Ghostty as Ctrl+F12) pins the key hints; they also pop up in any mode
        tooltip "Ctrl F12"
        // hide the "Ctrl F12 > Tooltip >" hint on the right (patched bars plugin)
        tooltip_hint "false"
        // put the key hints in the top-right corner (patched bars plugin)
        tooltip_position "top-right"
    }
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    // patched bars plugin (local build): `prefix` replaces " Zellij "
    tab-bar location="zellij:bars" {
        role "tab-bar"
        prefix " {hostname} "
    }
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

// Plugins to load in the background when a new session starts
// eg. "file:/path/to/my-plugin.wasm"
// eg. "https://example.com/my-plugin.wasm"
load_plugins {
}
 
// Use a simplified UI without special fonts (arrow glyphs)
// Options:
//   - true
//   - false (Default)
// 
// simplified_ui true
 
// Choose the theme that is specified in the themes section.
// Default: default
// 
// theme "dracula"
// theme "ayu-light"
theme "novelty"
 
// Choose the base input mode of zellij.
// Default: normal
// 
default_mode "normal"
 
// Choose the path to the default shell that zellij will use for opening new panes
// Default: $SHELL
// 
// default_shell "fish"
default_shell "/opt/homebrew/bin/bash"
 
// Choose the path to override cwd that zellij will use for opening new panes
// 
// default_cwd "/tmp"
 
// The name of the default layout to load on startup
// Default: "default"
// 
// default_layout "compact"
// compact layout starting with 7 tabs (layouts/seven-tabs.kdl)
default_layout "seven-tabs"
// The folder in which Zellij will look for layouts
// (Requires restart)
// 
// layout_dir "/tmp"
 
// The folder in which Zellij will look for themes
// (Requires restart)
// 
// theme_dir "/tmp"
 
// Toggle enabling the mouse mode.
// On certain configurations, or terminals this could
// potentially interfere with copying text.
// Options:
//   - true (default)
//   - false
// 
// mouse_mode false
 
// Toggle having pane frames around the panes
// Options:
//   - true (default, enabled)
//   - false
// 
// pane_frames false
 
// When attaching to an existing session with other users,
// should the session be mirrored (true)
// or should each user have their own cursor (false)
// (Requires restart)
// Default: false
// 
// mirror_session true
 
// Choose what to do when zellij receives SIGTERM, SIGINT, SIGQUIT or SIGHUP
// eg. when terminal window with an active zellij session is closed
// (Requires restart)
// Options:
//   - detach (Default)
//   - quit
// 
// on_force_close "quit"
 
// Configure the scroll back buffer size
// This is the number of lines zellij stores for each pane in the scroll back
// buffer. Excess number of lines are discarded in a FIFO fashion.
// (Requires restart)
// Valid values: positive integers
// Default value: 10000
// 
// scroll_buffer_size 10000
scroll_buffer_size 99000
 
// Provide a command to execute when copying text. The text will be piped to
// the stdin of the program to perform the copy. This can be used with
// terminal emulators which do not support the OSC 52 ANSI control sequence
// that will be used by default if this option is not set.
// Examples:
//
// copy_command "xclip -selection clipboard" // x11
// copy_command "wl-copy"                    // wayland
// copy_command "pbcopy"                     // osx
// 
// copy_command "pbcopy"
 
// Choose the destination for copied text
// Allows using the primary selection buffer (on x11/wayland) instead of the system clipboard.
// Does not apply when using copy_command.
// Options:
//   - system (default)
//   - primary
// 
// copy_clipboard "primary"
 
// Enable automatic copying (and clearing) of selection when releasing mouse
// Default: true
// 
// copy_on_select true
 
// Triple-click selects the line, not the whole OSC 133 command block (shell integration)
osc133_command_selection false
 
// Double-click word boundaries, same as Ghostty's selection-word-chars (whitespace always separates).
// Shift+double-click goes to Ghostty, which selects whole paths/URLs.
word_separators "'\"`|:;,()[]{}<>$/"
 
// Path to the default editor to use to edit pane scrollbuffer
// Default: $EDITOR or $VISUAL
// scrollback_editor "/usr/bin/vim"
 
// A fixed name to always give the Zellij session.
// Consider also setting `attach_to_session true,`
// otherwise this will error if such a session exists.
// Default: <RANDOM>
// 
// session_name "My singleton session"
 
// When `session_name` is provided, attaches to that session
// if it is already running or creates it otherwise.
// Default: false
// 
// attach_to_session true
 
// Toggle between having Zellij lay out panes according to a predefined set of layouts whenever possible
// Options:
//   - true (default)
//   - false
// 
// auto_layout false
 
// Whether sessions should be serialized to the cache folder (including their tabs/panes, cwds and running commands) so that they can later be resurrected
// Options:
//   - true (default)
//   - false
// 
// session_serialization false
 
// Whether pane viewports are serialized along with the session, default is false
// Options:
//   - true
//   - false (default)
// 
// serialize_pane_viewport false
 
// Scrollback lines to serialize along with the pane viewport when serializing sessions, 0
// defaults to the scrollback size. If this number is higher than the scrollback size, it will
// also default to the scrollback size. This does nothing if `serialize_pane_viewport` is not true.
// 
// scrollback_lines_to_serialize 10000
 
// Enable or disable the rendering of styled and colored underlines (undercurl).
// May need to be disabled for certain unsupported terminals
// (Requires restart)
// Default: true
// 
// styled_underlines false
 
// How often in seconds sessions are serialized
// 
// serialization_interval 10000
 
// Enable or disable writing of session metadata to disk (if disabled, other sessions might not know
// metadata info on this session)
// (Requires restart)
// Default: false
// 
// disable_session_metadata false
 
// Enable or disable support for the enhanced Kitty Keyboard Protocol (the host terminal must also support it)
// (Requires restart)
// Default: true (if the host terminal supports it)
// 
// support_kitty_keyboard_protocol false

// Native Zellij terminal — matched from iTerm2 profile "Novelty"
terminal {
    font "MonacoB"
    font_italic "MonacoB"
    font_size 10
    cursor_style "block"
    cursor_blink false
    bell "visual"
    macos_option_as_alt "left"
    opacity 0.97
    blur true
    startup_mode "windowed"
    initial_columns 80
    initial_rows 25

    // Novelty colors
    theme {
        foreground "#000000"
        background "#ddd9c3"
        cursor "#000000"
        black "#000000"
        red "#8a252c"
        green "#107a02"
        yellow "#706f00"
        blue "#0220b2"
        magenta "#ca30c7"
        cyan "#008383"
        white "#9c9c9c"
        bright_black "#484848"
        bright_red "#de4a4c"
        bright_green "#41c542"
        bright_yellow "#c0be4b"
        bright_blue "#4f55c5"
        bright_magenta "#ff77ff"
        bright_cyan "#42c6c6"
        bright_white "#ffffff"
    }
}
show_startup_tips false

// Hide the session name in the tab bar (and in the focused pane's frame)
ui {
    pane_frames {
        hide_session_name true
        // also draw the title line of a single pane with pane_frame_style "titles" (patched zellij)
        titles_on_single_pane true
    }
}

// Do not prompt to zoom/descend when a nested zellij starts (lock with Ctrl g instead)
nested_session_handling "never"

// Start with the status bar hidden: entering a mode (pane, tab, resize, ...) shows that mode's
// keys in a corner popup instead, and Ctrl+? brings back the status bar with the major modes
bars_hidden_on_start "status-bar"

// Scrollback editor/viewer (scroll mode: e = nvim, v = less with colors), via a wrapper named
// "vim" so zellij passes it the current scroll position. See /Users/fm/.config/zellij/bin/vim
scrollback_editor "/Users/fm/.config/zellij/bin/vim"
