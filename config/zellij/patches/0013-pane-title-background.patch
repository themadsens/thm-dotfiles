+    // Local patch: give the title line the theme's frame background: `frame_selected` for the
+    // focused pane, `frame_unselected` (or else `frame_selected`) for the others. Zellij otherwise
+    // only uses the frame colors' `base`. Characters that already have a background keep it.
+    fn title_background(&self) -> PaletteColor {
+        let colors = &self.style.colors;
+        if self.is_main_client {
+            colors.frame_selected.background
+        } else {
+            colors
+                .frame_unselected
+                .map(|frame| frame.background)
+                .unwrap_or(colors.frame_selected.background)
+        }
+    }
+    fn with_title_background(&self, mut characters: Vec<TerminalCharacter>) -> Vec<TerminalCharacter> {
+        let background = AnsiCode::from(self.title_background());
+        for character in characters.iter_mut() {
+            if character.styles.background.is_none() {
+                character.styles.update(|styles| styles.background = Some(background));
+            }
+        }
+        characters
+    }
