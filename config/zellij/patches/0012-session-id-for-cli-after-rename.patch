 /// Client entrypoint for all [`zellij_utils::cli::CliAction`]
 ///
 /// Checks session to send the action to and attaches with client
+// Local patch: the current name of the session this shell runs in, looked up by its stable id
+// (ZELLIJ_SESSION_ID). ZELLIJ_SESSION_NAME goes stale in running shells when the session is
+// renamed, so it is only the fallback.
+pub(crate) fn env_session() -> anyhow::Result<String> {
+    match envs::get_session_id() {
+        Ok(id) if !id.is_empty() && zellij_utils::consts::session_id_socket_path(&id).exists() => {
+            Ok(zellij_utils::sessions::display_name_for_session_id(&id))
+        },
+        _ => envs::get_session_name(),
+    }
+}
