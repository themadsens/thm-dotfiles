+    fn run_command_entries(mode_info: &ModeInfo, mode: InputMode) -> Vec<TooltipEntry> {
+        let mut by_label: Vec<(String, Vec<(String, Vec<Action>)>)> = Vec::new();
+        for (key, actions) in mode_info.get_keybinds_for_mode(mode) {
+            let command = match actions.first() {
+                Some(Action::Run { command, .. }) | Some(Action::RunInBackground { command }) => {
+                    command
+                },
+                _ => continue,
+            };
+            let label = command
+                .command
+                .file_name()
+                .map(|n| n.to_string_lossy().to_string())
+                .unwrap_or_else(|| command.command.to_string_lossy().to_string());
+            let keyed = (format!("{}", key), actions.clone());
+            match by_label.iter_mut().find(|(l, _)| *l == label) {
+                Some((_, keys)) => keys.push(keyed),
+                None => by_label.push((label, vec![keyed])),
+            }
+        }
+        by_label
+            .into_iter()
+            .map(|(description, keys)| TooltipEntry {
+                chunks: Self::group_key_chunks(&keys, true, false),
+                description,
+            })
+            .collect()
+    }
