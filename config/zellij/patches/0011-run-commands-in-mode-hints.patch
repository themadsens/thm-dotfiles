+    // Local patch: also list user-defined `Run` bindings (labelled with the
+    // command's file name), which the fixed per-mode lists below leave out
     pub fn get_tooltip_entries(mode_info: &ModeInfo, mode: InputMode) -> Vec<TooltipEntry> {
+        let mut entries = Self::predetermined_tooltip_entries(mode_info, mode);
+        if !matches!(mode, InputMode::Normal | InputMode::Locked) {
+            entries.extend(Self::run_command_entries(mode_info, mode));
+        }
+        entries
+    }
